{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brand AI-Ready Specification",
  "type": "object",
  "required": ["specVersion", "slug", "foundation", "tokens"],
  "properties": {
    "specVersion": { "type": "integer", "minimum": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "summary"],
        "properties": {
          "version": { "type": "integer" },
          "summary": { "type": "string" }
        }
      }
    },
    "foundation": {
      "type": "object",
      "required": ["name", "positioning", "audience", "personality", "voice"],
      "properties": {
        "name": { "type": "string" },
        "positioning": { "type": "string" },
        "audience": { "type": "array", "items": { "type": "string" } },
        "personality": { "type": "array", "items": { "type": "string" } },
        "voice": { "type": "string" }
      }
    },
    "tokens": {
      "type": "object",
      "description": "Mirrors 04-design-tokens/tokens.json",
      "required": ["schemaVersion", "tokens"],
      "properties": {
        "schemaVersion": { "type": "integer" },
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "layer", "category", "value"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "layer": { "enum": ["primitive", "semantic", "component"] },
              "category": { "type": "string" },
              "value": {},
              "reference": { "type": "string" },
              "theme": { "enum": ["light", "dark"] }
            }
          }
        }
      }
    },
    "printColors": {
      "type": "array",
      "description": "Physical reproduction equivalents declared in 21-corporate-visual-identity/production-specs.md. Each entry must map to a hex already present in 02-color-system; it never introduces a new brand color.",
      "items": {
        "type": "object",
        "required": ["tokenId", "hex"],
        "properties": {
          "tokenId": { "type": "string", "description": "Primitive color token this physical value reproduces" },
          "hex": { "type": "string", "pattern": "^#([0-9a-fA-F]{6})$" },
          "pantoneCoated": { "type": "string" },
          "pantoneUncoated": { "type": "string" },
          "cmyk": {
            "type": "array",
            "description": "C, M, Y, K as percentages",
            "items": { "type": "number", "minimum": 0, "maximum": 100 },
            "minItems": 4,
            "maxItems": 4
          },
          "ral": { "type": "string" },
          "vinyl": { "type": "string" },
          "thread": { "type": "string", "description": "Embroidery thread reference, e.g. Madeira/Isacord code" }
        }
      }
    },
    "subsystems": {
      "type": "object",
      "description": "Map of folder name -> relative doc path, for every generated subsystem beyond foundation/tokens",
      "additionalProperties": { "type": "string" }
    }
  }
}
